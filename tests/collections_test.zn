// Collection type tests

fn test_array_basics() {
    let nums = [1, 2, 3, 4, 5];
    assert_eq(len(nums), 5);
    assert_eq(nums[0], 1);
    assert_eq(nums[4], 5);
}

fn test_array_add_push() {
    var items: array(int) = [];
    items.add(10);
    items.add(20);
    assert_eq(len(items), 2);
    assert_eq(items[0], 10);
    assert_eq(items[1], 20);

    // push prepends to the front
    items.push(5);
    assert_eq(items[0], 5);
    assert_eq(len(items), 3);
}

fn test_array_concat() {
    let a = [1, 2];
    let b = [3, 4];
    let c = a + b;
    assert_eq(len(c), 4);
    assert_eq(c[0], 1);
    assert_eq(c[3], 4);
}

fn test_array_max_min_sum() {
    let nums = [3, 1, 4, 1, 5];
    assert_eq(nums.max(), 5);
    assert_eq(nums.min(), 1);
    assert_eq(nums.sum(), 14);
}

fn test_array_sorted() {
    let nums = [3, 1, 4, 1, 5];
    let s = nums.sorted();
    assert_eq(s[0], 1);
    assert_eq(s[1], 1);
    assert_eq(s[2], 3);
    assert_eq(s[3], 4);
    assert_eq(s[4], 5);

    // descending
    let d = nums.sorted("desc");
    assert_eq(d[0], 5);
    assert_eq(d[1], 4);
    assert_eq(d[2], 3);
    assert_eq(d[3], 1);
    assert_eq(d[4], 1);

    // explicit ascending
    let a = nums.sorted("asc");
    assert_eq(a[0], 1);
    assert_eq(a[4], 5);
}

fn test_array_map_filter() {
    let nums = [1, 2, 3, 4, 5];
    let doubled = nums.map(fn(x) x * 2);
    assert_eq(doubled[0], 2);
    assert_eq(doubled[4], 10);

    let evens = nums.filter(fn(x) x % 2 == 0);
    assert_eq(len(evens), 2);
    assert_eq(evens[0], 2);
    assert_eq(evens[1], 4);
}

fn test_hashmap() {
    var m = hashmap(str, int);
    m["alice"] = 95;
    m["bob"] = 80;
    assert_eq(len(m), 2);
    assert_eq(m["alice"], 95);
    assert(m.exists("bob"));
    assert(!m.exists("charlie"));
}

fn test_tuple() {
    let t = tuple("hello", 42);
    assert_eq(t.0, "hello");
    assert_eq(t.1, 42);
}
