// Basic language feature tests

fn test_arithmetic() {
    AssertEq(2 + 3, 5);
    AssertEq(10 - 4, 6);
    AssertEq(3 * 7, 21);
    AssertEq(10 / 3, 3);
    AssertEq(10 % 3, 1);
}

fn test_variables() {
    let x = 42;
    AssertEq(x, 42);

    var y = 10;
    y = 20;
    AssertEq(y, 20);

    y += 5;
    AssertEq(y, 25);
}

fn test_booleans() {
    Assert(true);
    Assert(!false);
    Assert(1 < 2);
    Assert(2 > 1);
    Assert(3 >= 3);
    Assert(3 <= 3);
    AssertEq(true, true);
    AssertEq(false, false);
}

fn test_strings() {
    let s = "hello";
    AssertEq(Len(s), 5);
    AssertEq(s.upper(), "HELLO");
    AssertEq("WORLD".lower(), "world");
    Assert(s.starts_with("hel"));
    Assert(s.ends_with("llo"));
    Assert(s.contains("ell"));
}

fn test_string_methods() {
    AssertEq("  hi  ".strip(), "hi");
    AssertEq("fold along x=5".strip_prefix("fold along "), "x=5");
    AssertEq("photo.png".strip_suffix(".png"), "photo");
    AssertEq(".".repeat(3), "...");
    AssertEq("banana".find("na"), 2);
    AssertEq("banana".count("na"), 2);
    AssertEq("a-b-a".replace("a", "x"), "x-b-x");
}

fn test_if_expression() {
    let x = 10;
    let label = if x > 5 { "big" } else { "small" };
    AssertEq(label, "big");
}
