fn main() {
    // Basic map
    let numbers = [1, 2, 3, 4, 5];
    let doubled = numbers.map(fn(x) x * 2);
    println("doubled: {doubled[0]},{doubled[1]},{doubled[2]},{doubled[3]},{doubled[4]}");

    // Basic filter
    let evens = numbers.filter(fn(x) x % 2 == 0);
    println("evens: {evens[0]},{evens[1]}");

    // Chaining
    let result = [1, 2, 3, 4, 5].filter(fn(x) x > 2).map(fn(x) x * 10);
    println("chained: {result[0]},{result[1]},{result[2]}");

    // String slices
    let names = ["alice", "bob", "charlie"];
    let lengths = names.map(fn(s) len(s));
    println("lengths: {lengths[0]},{lengths[1]},{lengths[2]}");

    // Block closure
    let processed = [10, 20, 30].map(fn(x: int) -> int {
        let y = x + 1;
        return y;
    });
    println("processed: {processed[0]},{processed[1]},{processed[2]}");

    // Explicit types
    let typed = [1, 2, 3].map(fn(x: int) -> int x * 3);
    println("typed: {typed[0]},{typed[1]},{typed[2]}");

    // Filter with bool
    let big = [10, 5, 20, 3, 15].filter(fn(x) x > 10);
    println("big: {big[0]},{big[1]}");
}
