fn main() {
    // Date.today()
    let today = Date.today();
    let formatted = today.format("%Y-%m-%d");
    Println("today: " + formatted);

    // Date.from() with default format
    let epoch = Date.from("1970-01-01");
    Println("epoch: " + epoch.format("%Y-%m-%d"));

    // Date.from() with custom format
    let jan13 = Date.from("01/13/2007", "%m/%d/%Y");
    Println("jan13: " + jan13.format("%Y-%m-%d"));

    // add days (default unit)
    let tomorrow = epoch.add(1);
    Println("tomorrow: " + tomorrow.format("%Y-%m-%d"));

    // add months
    let next_month = epoch.add(1, "months");
    Println("next_month: " + next_month.format("%Y-%m-%d"));

    // add years
    let next_year = epoch.add(1, "years");
    Println("next_year: " + next_year.format("%Y-%m-%d"));

    // sub days
    let yesterday = Date.from("1970-01-02").sub(1);
    Println("yesterday: " + yesterday.format("%Y-%m-%d"));

    // sub months
    let prev_month = Date.from("1970-02-01").sub(1, "months");
    Println("prev_month: " + prev_month.format("%Y-%m-%d"));

    // chaining
    let chained = Date.from("2000-06-15").add(1, "years").add(3, "months").add(10);
    Println("chained: " + chained.format("%Y-%m-%d"));

    // different format specifiers
    Println("formatted: " + jan13.format("%d/%m/%Y"));

    // Str conversion
    let d = Date.from("2024-03-21");
    Println("str: " + Str(d));
}
