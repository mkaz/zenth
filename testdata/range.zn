// Test Range() and Rangei() built-in functions

fn main() {
    // Basic Range (exclusive end)
    let nums = Range(0, 5);
    Println("Range(0,5): " + Str(Len(nums)));
    for n in nums {
        Print(Str(n) + " ");
    }
    Println("");

    // Rangei (inclusive end)
    let inc = Rangei(1, 5);
    Println("Rangei(1,5): " + Str(Len(inc)));
    for n in inc {
        Print(Str(n) + " ");
    }
    Println("");

    // range with step
    let evens = Range(0, 10, 2);
    Println("Range(0,10,2): " + Str(Len(evens)));
    for n in evens {
        Print(Str(n) + " ");
    }
    Println("");

    // rangei with step
    let by3 = Rangei(0, 10, 3);
    Println("Rangei(0,10,3): " + Str(Len(by3)));
    for n in by3 {
        Print(Str(n) + " ");
    }
    Println("");

    // for-in with index
    for i, v in Range(10, 13) {
        Println("i=" + Str(i) + " v=" + Str(v));
    }
}
