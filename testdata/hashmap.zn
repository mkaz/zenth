obj Point {
    x: int;
    y: int;
}

fn main() {
    let pt = Point(x=1, y=2);
    let same = Point(x=1, y=2);
    var grid = Hashmap(Point, str);
    grid[pt] = "#";

    Println("val=" + grid[same]);
    Println("len=" + Str(Len(grid)));

    var scores = Hashmap(str, int);
    scores["Alice"] = 95;
    scores["Bert"] = 80;
    Println(scores);
}
