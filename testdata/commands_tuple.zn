fn main() {
    let data = [
        "forward 1",
        "backward 2",
        "left 3"
    ];

    var cmds: array(Tuple(str, int)) = [];
    for row in data {
        let (cmd, raw) = row.split_once(" ");
        cmds.add(Tuple(cmd, Int(raw)));
    }

    Println("Found: " + Str(cmds.length()));
    Println(cmds[0].0 + "=" + Str(cmds[0].1));
}
