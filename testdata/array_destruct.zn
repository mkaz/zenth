fn main() {
    // Basic array destructuring
    let nums = [10, 20, 30];
    let [a, b, c] = nums;
    Println(a);
    Println(b);
    Println(c);

    // Destructure from inline array
    let [x, y] = [100, 200];
    Println(x);
    Println(y);

    // Discard with _
    let [first, _, third] = [1, 2, 3];
    Println(first);
    Println(third);

    // var destructuring (mutable)
    var [p, q] = [5, 6];
    p = 99;
    Println(p);
    Println(q);

    // Destructure from method chain
    let line = "12x4x8";
    let dims = line.split("x").to_int().sorted();
    let [l, w, h] = dims;
    Println(l);
    Println(w);
    Println(h);
}
