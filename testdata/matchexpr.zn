// Match expressions (match as a value)
fn day_name(d: int) -> str {
    return match d {
        1 => "Monday"
        2 => "Tuesday"
        3 => "Wednesday"
        _ => "Other"
    };
}

fn main() {
    // Assignment from match expression
    let label = match 2 {
        1 => "one"
        2 => "two"
        3 => "three"
        _ => "other"
    };
    println(label);

    // Inline in function call
    println(match 99 {
        1 => "first"
        _ => "default"
    });

    // Match expression in function return
    println(day_name(1));
    println(day_name(3));
    println(day_name(7));

    // Integer match expression
    let val = match "hi" {
        "hello" => 1
        "hi" => 2
        _ => 0
    };
    println(str(val));
}
