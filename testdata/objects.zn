// Objects and methods in Zenth
obj Point {
    x: f64;
    y: f64;

    fn string() -> str {
        return "({self.x}, {self.y})";
    }

    fn distance(pt: Point) -> f64 {
        let x_dist = self.x - pt.x;
        let y_dist = self.y - pt.y;
        // Need to absolute value
        return x_dist + y_dist;
    }
}

obj Rectangle {
    width: f64;
    height: f64;

    fn area() -> f64 {
        return self.width * self.height;
    }
}

obj Account {
    balance: int = 0;
    interest: f64 = 2.5;
}

fn main() {
    let origin = Point(x=0.0, y=0.0);
    let corner = Point(x=3.0, y=4.0);

    Println("Origin: {origin.string()}");
    Println("Corner: {corner.string()}");

    Println("Distance between: {origin.distance(corner)}");
    let rect = Rectangle(width=10.0, height=5.0);
    Println("Area: {rect.area()}");

    // Test default values
    let a1 = Account();
    Println("a1: {Str(a1.balance)} {Str(a1.interest)}");

    let a2 = Account(balance=100);
    Println("a2: {Str(a2.balance)} {Str(a2.interest)}");

    let a3 = Account(interest=5.0, balance=1000);
    Println("a3: {Str(a3.balance)} {Str(a3.interest)}");
}
