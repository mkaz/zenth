// String and slice slicing syntax
fn main() {
    let s = "abcde";

    // String slicing
    Println(s[1:]);    // "bcde"
    Println(s[:2]);    // "ab"
    Println(s[1:3]);   // "bc"

    // Slice slicing
    let nums = [10, 20, 30, 40, 50];
    let tail = nums[2:];
    Println(Len(tail));  // 3
    Println(tail[0]);    // 30

    let head = nums[:3];
    Println(Len(head));  // 3
    Println(head[2]);    // 30

    let mid = nums[1:4];
    Println(Len(mid));   // 3
    Println(mid[0]);     // 20
}
