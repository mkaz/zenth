// Match statements and control flow
fn fizzbuzz(n: int) -> str {
    if n % 15 == 0 {
        return "FizzBuzz";
    } else if n % 3 == 0 {
        return "Fizz";
    } else if n % 5 == 0 {
        return "Buzz";
    } else {
        return str(n);
    }
}

fn main() {
    // FizzBuzz
    for var i = 1; i <= 20; i++ {
        println(fizzbuzz(i));
    }

    // Match statement
    let day = 3;
    match day {
        1 => println("Monday");
        2 => println("Tuesday");
        3 => println("Wednesday");
        4 => println("Thursday");
        5 => println("Friday");
        _ => println("Weekend");
    }
}
