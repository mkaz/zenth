// Match statements and control flow
fn fizzbuzz(n: Int) -> Str {
    if n % 15 == 0 {
        return "FizzBuzz";
    } else if n % 3 == 0 {
        return "Fizz";
    } else if n % 5 == 0 {
        return "Buzz";
    } else {
        return Str(n);
    }
}

fn main() {
    // FizzBuzz
    for var i = 1; i <= 20; i++ {
        Println(fizzbuzz(i));
    }

    // Match statement
    let day = 3;
    match day {
        1 => Println("Monday");
        2 => Println("Tuesday");
        3 => Println("Wednesday");
        4 => Println("Thursday");
        5 => Println("Friday");
        _ => Println("Weekend");
    }
}
