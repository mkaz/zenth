// Test array Max() and Min() methods

fn main() {
    let nums = [3, 1, 4, 1, 5, 9, 2, 6];
    Println("max=" + Str(nums.max()));
    Println("min=" + Str(nums.min()));

    // Single element
    let single = [42];
    Println("single_max=" + Str(single.max()));
    Println("single_min=" + Str(single.min()));

    // Float arrays
    let floats = [3.14, 2.71, 1.41, 1.73];
    Println("fmax=" + Str(floats.max()));
    Println("fmin=" + Str(floats.min()));

    // Negative numbers
    let negatives = [-5, -1, -10, -3];
    Println("neg_max=" + Str(negatives.max()));
    Println("neg_min=" + Str(negatives.min()));
}
