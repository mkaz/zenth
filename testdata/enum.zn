// Test basic enum functionality

enum Color {
    Red;
    Green;
    Blue;
}

enum HexColor {
    Red = "#FF0000";
    Green = "#00FF00";
    Blue = "#0000FF";
}

fn main() {
    let c = Color.Red;
    Println(c);

    let g = Color.Green;
    Println(g);

    let b = Color.Blue;
    Println(b);

    // Enum comparison
    if c == Color.Red {
        Println("is red");
    }

    if c != Color.Blue {
        Println("not blue");
    }

    // Match on enum
    match g {
        Color.Red => Println("matched red");
        Color.Green => Println("matched green");
        Color.Blue => Println("matched blue");
        _ => Println("unknown");
    }

    // Explicit string values
    let h = HexColor.Red;
    Println(h);

    // Enum with type annotation
    let h2: HexColor = HexColor.Green;
    Println(h2);
}
