// Test basic enum functionality

enum Color {
    Red;
    Green;
    Blue;
}

enum HexColor {
    Red = "#FF0000";
    Green = "#00FF00";
    Blue = "#0000FF";
}

fn main() {
    let c = Color.Red;
    println(c);

    let g = Color.Green;
    println(g);

    let b = Color.Blue;
    println(b);

    // Enum comparison
    if c == Color.Red {
        println("is red");
    }

    if c != Color.Blue {
        println("not blue");
    }

    // Match on enum
    match g {
        Color.Red => println("matched red");
        Color.Green => println("matched green");
        Color.Blue => println("matched blue");
        _ => println("unknown");
    }

    // Explicit string values
    let h = HexColor.Red;
    println(h);

    // Enum with type annotation
    let h2: HexColor = HexColor.Green;
    println(h2);
}
