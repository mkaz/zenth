fn main() {
    // compound assignment on missing key
    var m = Hashmap(str, int, default=0);
    m["foo"] += 1;
    m["foo"] += 2;
    Println("foo=" + Str(m["foo"]));

    // read missing key returns default
    Println("bar=" + Str(m["bar"]));

    // overwrite works normally
    m["baz"] = 42;
    Println("baz=" + Str(m["baz"]));

    // len reflects only assigned keys
    Println("len=" + Str(Len(m)));

    // increment with ++
    var c = Hashmap(str, int, default=0);
    c["x"]++;
    c["x"]++;
    Println("x=" + Str(c["x"]));
}
