// Test assert and assert_eq built-in functions

fn main() {
    // assert with true condition
    Assert(1 + 1 == 2);
    Assert(true);
    Assert("hello".starts_with("hel"));

    // assert_eq with matching values
    AssertEq(1 + 1, 2);
    AssertEq("hello", "hello");
    AssertEq(true, true);
    AssertEq(3.14, 3.14);

    // assert_eq with computed values
    let nums = [1, 2, 3, 4, 5];
    AssertEq(nums.sum(), 15);
    AssertEq(nums.max(), 5);
    AssertEq(nums.min(), 1);

    AssertEq("fold along x=5".strip_prefix("fold along "), "x=5");

    Println("all assertions passed");
}
