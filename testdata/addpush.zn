// Test .add() and .push() methods on arrays
fn main() {
    var a = [2, 3, 4];

    a.add(5);
    Println("after add: " + Str(Len(a)));
    Println("last=" + Str(a[3]));

    a.push(1);
    Println("after push: " + Str(Len(a)));
    Println("first=" + Str(a[0]));
    Println("second=" + Str(a[1]));
}
