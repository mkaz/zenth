fn main() {
    let ints = [2, 4, 4, 4, 5, 5, 7, 9];
    Println("total_i=" + Str(ints.total()));
    Println("mean_i=" + Str(ints.mean()));
    Println("median_i=" + Str(ints.median()));
    Println("stdev_i=" + Str(ints.stdev()));

    let floats = [2.0, 4.0, 4.0, 4.0, 5.0, 5.0, 7.0, 9.0];
    Println("total_f=" + Str(floats.total()));
    Println("mean_f=" + Str(floats.mean()));
    Println("median_f=" + Str(floats.median()));
    Println("stdev_f=" + Str(floats.stdev()));

    // median even vs odd length
    let even = [1, 3, 5, 7];
    Println("median_even=" + Str(even.median()));
    let odd = [1, 3, 5];
    Println("median_odd=" + Str(odd.median()));

    // single element
    let single = [42];
    Println("mean_single=" + Str(single.mean()));
    Println("stdev_single=" + Str(single.stdev()));
}
