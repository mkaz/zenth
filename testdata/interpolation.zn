// String interpolation tests
fn main() {
    // Basic interpolation
    let name = "World";
    Println("Hello {name}!");

    // Multiple interpolations
    let a = 3;
    let b = 4;
    Println("{a} + {b} = {a + b}");

    // Plain string (no interpolation)
    Println("No interpolation here");

    // Raw string with single quotes (no interpolation)
    Println('Raw {name} string');

    // Escaped braces
    Println("Use \{braces\} literally");

    // Expression in braces
    let x = 10;
    let y = 20;
    Println("Result: {x + y}");

    // Nested field access
    let r = Rectangle(width=5.0, height=10.0);
    Println("Area: {r.area()}");

    // Interpolation with str type
    let greeting = "hi";
    Println("Say: {greeting}");
}

obj Rectangle {
    width: Float;
    height: Float;

    fn area() -> Float {
        return self.width * self.height;
    }
}
