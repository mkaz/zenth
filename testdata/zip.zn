// Test zip built-in function

fn main() {
    let names = ["Alice", "Bob", "Charlie"];
    let scores = [95, 87, 92];

    // Basic zip and iterate
    for pair in Zip(names, scores) {
        Println(pair.0 + "=" + Str(pair.1));
    }

    // Zip with different length arrays (uses shorter length)
    let a = [1, 2, 3, 4];
    let b = [10, 20];
    for t in Zip(a, b) {
        Println(Str(t.0) + "+" + Str(t.1));
    }

    // Zip three arrays
    let x = [1, 2, 3];
    let y = [4, 5, 6];
    let z = [7, 8, 9];
    for t in Zip(x, y, z) {
        Println(Str(t.0) + "," + Str(t.1) + "," + Str(t.2));
    }
}

// Expected output:
// Alice=95
// Bob=87
// Charlie=92
// 1+10
// 2+20
// 1,4,7
// 2,5,8
// 3,6,9
