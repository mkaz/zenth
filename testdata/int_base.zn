fn main() {
    // Int(Str, base) — binary
    let bin = Int("1010", 2);
    Println(Str(bin));

    // Int(Str, base) — hexadecimal
    let hex = Int("ff", 16);
    Println(Str(hex));

    // Int(Str, base) — octal
    let oct = Int("77", 8);
    Println(Str(oct));

    // Still works: str.to_int(base) equivalent
    let same = "1010".to_int(2);
    Println(Str(same));

    // Regular Int() still works
    let normal = Int("42");
    Println(Str(normal));
}
