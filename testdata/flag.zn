// Test Args.flag() and Args.args() built-ins

fn main() {
    let debug = Args.flag(default=false);
    let times = Args.flag(default=5);
    let msg = Args.flag(default="Hello");

    Println("debug=" + Str(debug));
    Println("times=" + Str(times));
    Println("msg=" + msg);

    let remaining = Args.args();
    Println("args=" + Str(Len(remaining)));
}
