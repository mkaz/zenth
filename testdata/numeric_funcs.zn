fn main() {
    Println("abs_i=" + Str(Abs(-5)));
    Println("abs_f=" + Str(Abs(-2.5)));

    Println("min_i=" + Str(Min(3, 7)));
    Println("max_i=" + Str(Max(3, 7)));
    Println("clamp_i=" + Str(Clamp(12, 0, 10)));

    Println("min_f=" + Str(Min(1.5, 2.5)));
    Println("max_f=" + Str(Max(1.5, 2.5)));
    Println("clamp_f=" + Str(Clamp(12.5, 0.0, 10.0)));

    Println("round=" + Str(Round(3.6)));
    Println("floor=" + Str(Floor(3.6)));
    Println("ceil=" + Str(Ceil(3.1)));
    Println("pow=" + Str(Pow(2, 3)));
    Println("sqrt=" + Str(Sqrt(9)));
}
