// mathutils module - simple math helper functions

fn add(a: Int, b: Int) -> Int {
    return a + b;
}

fn multiply(a: Int, b: Int) -> Int {
    return a * b;
}

fn max_of(a: Int, b: Int) -> Int {
    if a > b {
        return a;
    }
    return b;
}

// Internal call: sum_and_double calls add (another function in the same module)
fn sum_and_double(a: Int, b: Int) -> Int {
    let s = add(a, b);
    return multiply(s, 2);
}

const pi = 3.14159;
