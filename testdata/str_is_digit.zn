// Test str.is_digit() character classification
fn main() {
    Println("5=" + Str("5".is_digit()));   // true
    Println("0=" + Str("0".is_digit()));   // true
    Println("9=" + Str("9".is_digit()));   // true
    Println("a=" + Str("a".is_digit()));   // false
    Println("[=" + Str("[".is_digit()));   // false
    Println(",=" + Str(",".is_digit()));   // false

    // typical use: classify chars in a string
    var digits = 0;
    for ch in "abc123" {
        if ch.is_digit() {
            digits += 1;
        }
    }
    Println("digits=" + Str(digits));  // 3
}
