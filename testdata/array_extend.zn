// Test array extend method

fn main() {
    var nums = [1, 2, 3];
    let more = [4, 5, 6];
    nums.extend(more);
    Println(Len(nums));
    for n in nums {
        Print(Str(n) + " ");
    }
    Println("");

    // Extend with empty array
    var items = [10, 20];
    let empty: Array(Int) = [];
    items.extend(empty);
    Println(Len(items));

    // Extend strings
    var words = ["hello"];
    words.extend(["world", "!"]);
    Println(words.join(" "));
}

// Expected output:
// 6
// 1 2 3 4 5 6
// 2
// hello world !
