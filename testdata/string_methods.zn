fn main() {
    Println("u=" + "hello".upper());
    Println("l=" + "HeLLo".lower());
    Println("sw=" + Str("zenth".starts_with("zen")));
    Println("ew=" + Str("zenth".ends_with("th")));
    Println("strip=--" + "  hi  ".strip() + "--");
    Println("stripc=--" + "..hi..".strip(".") + "--");
    Println("find=" + Str("banana".find("na")));
    Println("count=" + Str("banana".count("na")));
    Println("repall=" + "a-b-a".replace("a", "x"));
    Println("repn=" + "a-b-a".replace("a", "x", 1));
}
