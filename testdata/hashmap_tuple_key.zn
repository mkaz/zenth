// Test hashmap with tuple keys

fn main() {
    // Create hashmap with tuple keys
    var grid = Hashmap(Tuple(Int,Int),Str);
    grid[Tuple(0, 0)] = "origin";
    grid[Tuple(1, 2)] = "point";
    grid[Tuple(3, 4)] = "far";

    // Read values
    Println(grid[Tuple(0, 0)]);
    Println(grid[Tuple(1, 2)]);

    // Check existence
    Println(grid.exists(Tuple(0, 0)));
    Println(grid.exists(Tuple(9, 9)));

    // Iterate (count only)
    var count = 0;
    for _, _ in grid {
        count++;
    }
    Println(count);

    // Iterate with key access
    var small = Hashmap(Tuple(Int,Int),Str);
    small[Tuple(1, 2)] = "yes";
    for k in small {
        Println(k.0);
        Println(k.1);
    }

    // Iterate with key and value
    for _, v in small {
        Println(v);
    }

    // String tuple keys
    var lookup = Hashmap(Tuple(Str,Str),Int);
    lookup[Tuple("a", "b")] = 1;
    lookup[Tuple("c", "d")] = 2;
    Println(lookup[Tuple("a", "b")]);
    Println(lookup[Tuple("c", "d")]);
}

// Expected output:
// origin
// point
// true
// false
// 3
// 1
// 2
// yes
// 1
// 2
