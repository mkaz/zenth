fn main() {
    var m = Hashmap(Str,Int);
    m["a"] = 1;
    m["b"] = 2;
    m["c"] = 3;

    // for k, v in m
    var sum = 0;
    for k, v in m {
        sum += v;
        Println("kv=" + k);
    }
    Println("sum=" + Str(sum));

    // for k in m (keys only)
    var count = 0;
    for k in m {
        count += 1;
        Println("k=" + k);
    }
    Println("count=" + Str(count));

    // m.keys()
    let keys = m.keys();
    Println("nkeys=" + Str(Len(keys)));

    // m.values()
    let vals = m.values();
    var vsum = 0;
    for v in vals {
        vsum += v;
    }
    Println("vsum=" + Str(vsum));
}
