// Variables and types in Zenth
fn main() {
    // Type inference with =
    let name = "Zenth";
    let year = 2026;
    let pi = 3.14159;
    let active = true;

    Println("Language: {name}");
    Println("Year: {year}");

    // Mutable variables
    var counter = 0;
    counter = counter + 1;
    counter += 1;
    Println("Counter: {counter}");

    // If/else
    if counter > 1 {
        Println("Counter is greater than 1");
    } else {
        Println("Counter is 1 or less");
    }

    // For loop
    var sum = 0;
    for i in Range(1,10) {
        sum += i;
    }
    Println("Sum 1..10: {sum}");
}
