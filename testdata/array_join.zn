// Test array join method

fn main() {
    let words = ["hello", "world"];
    Println(words.join(" "));

    let csv = ["a", "b", "c"];
    Println(csv.join(","));

    // Join with empty separator
    let letters = ["x", "y", "z"];
    Println(letters.join(""));

    // Join single element
    let one = ["solo"];
    Println(one.join("-"));

    // Join with multi-char separator
    let parts = ["2026", "03", "15"];
    Println(parts.join("-"));
}

// Expected output:
// hello world
// a,b,c
// xyz
// solo
// 2026-03-15
