// Test Set(Tuple(...)) with struct-based key representation

fn main() {
    // Create a set of (Int,Int) tuples
    var dots = Set(Tuple(Int,Int));
    dots.add(Tuple(6, 10));
    dots.add(Tuple(0, 14));
    dots.add(Tuple(9, 10));
    dots.add(Tuple(0, 3));
    Println("size=" + Str(Len(dots)));

    // Duplicate should not increase size
    dots.add(Tuple(6, 10));
    Println("after_dup=" + Str(Len(dots)));

    // exists check
    if dots.exists(Tuple(6, 10)) {
        Println("found 6,10");
    }
    if !dots.exists(Tuple(1, 1)) {
        Println("1,1 not found");
    }

    // remove
    dots.remove(Tuple(0, 3));
    Println("after_remove=" + Str(Len(dots)));

    // length method
    Println("length=" + Str(dots.length()));

    // Iteration
    var sum = 0;
    for dot in dots {
        sum += dot.0 + dot.1;
    }
    Println("sum=" + Str(sum));

    // Set(Tuple(Str,Int))
    var pairs = Set(Tuple(Str,Int));
    pairs.add(Tuple("x", 5));
    pairs.add(Tuple("y", 7));
    pairs.add(Tuple("x", 5));
    Println("pairs=" + Str(Len(pairs)));

    let dupDots = [Tuple(1, 2), Tuple(1, 2), Tuple(2, 3)];
    let uniqDots = Set(dupDots);
    Println("from_array=" + Str(Len(uniqDots)));
}
