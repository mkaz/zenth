// Test set data structure

fn main() {
    // Create a set and add elements
    var visited = Set(Str);
    visited.add("start");
    visited.add("middle");
    visited.add("end");
    Println(Len(visited));

    // exists() check
    if visited.exists("start") {
        Println("found start");
    }
    if !visited.exists("unknown") {
        Println("unknown not found");
    }

    // remove()
    visited.remove("middle");
    Println(Len(visited));

    // Duplicate add (should not increase size)
    visited.add("start");
    Println(Len(visited));

    // length() method
    Println(visited.length());

    // Integer set
    var nums = Set(Int);
    nums.add(1);
    nums.add(2);
    nums.add(3);
    nums.add(2);
    Println(Len(nums));

    // for-in iteration
    var total = 0;
    for n in nums {
        total += n;
    }
    Println(total);

    // Set with explicit type annotation
    var flags: Set(Str) = Set(Str);
    flags.add("verbose");
    flags.add("debug");
    Println(Len(flags));

    // Array -> set conversion
    let letters = ["a", "b", "a"];
    let unique = Set(letters);
    Println("letters=" + Str(Len(unique)));
    if unique.exists("a") {
        Println("has a");
    }

    let nums2 = [1, 2, 2, 3, 1];
    let uniqueNums: Set(Int) = Set(nums2);
    Println("nums2=" + Str(Len(uniqueNums)));
}
