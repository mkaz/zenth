// Test set data structure

fn main() {
    // Create a set and add elements
    var visited = set(str);
    visited.add("start");
    visited.add("middle");
    visited.add("end");
    println(len(visited));

    // exists() check
    if visited.exists("start") {
        println("found start");
    }
    if !visited.exists("unknown") {
        println("unknown not found");
    }

    // remove()
    visited.remove("middle");
    println(len(visited));

    // Duplicate add (should not increase size)
    visited.add("start");
    println(len(visited));

    // length() method
    println(visited.length());

    // Integer set
    var nums = set(int);
    nums.add(1);
    nums.add(2);
    nums.add(3);
    nums.add(2);
    println(len(nums));

    // for-in iteration
    var total = 0;
    for n in nums {
        total += n;
    }
    println(total);

    // Set with explicit type annotation
    var flags: set(str) = set(str);
    flags.add("verbose");
    flags.add("debug");
    println(len(flags));
}
