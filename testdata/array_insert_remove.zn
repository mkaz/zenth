// Test array.insert() and array.remove()
fn main() {
    var nums = [1, 2, 4, 5];

    // insert 3 at index 2
    nums.insert(2, 3);
    println("after insert: " + str(len(nums)));  // 5
    println("at[2]=" + str(nums[2]));            // 3
    println("at[3]=" + str(nums[3]));            // 4

    // remove element at index 1 (removes 2)
    nums.remove(1);
    println("after remove: " + str(len(nums)));  // 4
    println("at[0]=" + str(nums[0]));            // 1
    println("at[1]=" + str(nums[1]));            // 3
    println("at[2]=" + str(nums[2]));            // 4
    println("at[3]=" + str(nums[3]));            // 5
}
