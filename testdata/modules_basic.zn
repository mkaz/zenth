import "./testmods/mathutils";

fn main() {
    let result = mathutils.add(3, 4);
    Println(Str(result));

    let product = mathutils.multiply(6, 7);
    Println(Str(product));

    let biggest = mathutils.max_of(10, 20);
    Println(Str(biggest));

    // Test module-internal function calls (sum_and_double calls add and multiply)
    let doubled = mathutils.sum_and_double(5, 3);
    Println(Str(doubled));
}
