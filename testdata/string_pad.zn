fn main() {
    // pad_right with default space fill
    Println("'" + "hello".pad_right(10) + "'");

    // pad_left with default space fill
    Println("'" + "hello".pad_left(10) + "'");

    // pad_left with custom fill
    Println("42".pad_left(5, "0"));

    // pad_right with custom fill
    Println("hi".pad_right(6, "."));

    // no padding needed (already wide enough)
    Println("toolong".pad_right(3));
    Println("toolong".pad_left(3));

    // tabular output
    let items = ["apples", "bread", "milk"];
    let prices = ["1.50", "2.99", "3.25"];
    for i, item in items {
        Println(item.pad_right(10) + prices[i].pad_left(6));
    }
}
