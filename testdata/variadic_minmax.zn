fn main() {
    // 2-arg min/Max (existing)
    Println(Min(3, 7));
    Println(Max(3, 7));

    // 3-arg
    Println(Min(5, 2, 8));
    Println(Max(5, 2, 8));

    // 4-arg
    Println(Min(9, 3, 6, 1));
    Println(Max(9, 3, 6, 1));

    // f64 variadic
    Println(Min(1.5, 0.5, 2.5));
    Println(Max(1.5, 0.5, 2.5));
}
