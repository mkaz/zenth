// Test file built-in type
fn main() {
    let f = File("../../testdata/file.zn");

    // exists
    if f.exists() {
        Println("exists=true");
    } else {
        Println("exists=false");
    }

    // name and ext
    Println("name=" + f.name());
    Println("ext=" + f.ext());

    // read returns a string
    let content = f.read();
    if Len(content) > 0 {
        Println("read=ok");
    }

    // lines returns array(str)
    let lines = f.lines();
    if lines.length() > 0 {
        Println("lines=ok");
    }

    // non-existent file
    let nope = File("does_not_exist.zn");
    if nope.exists() {
        Println("nope=true");
    } else {
        Println("nope=false");
    }
}
