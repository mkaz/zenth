// Test nested generic types in type annotations

// Type alias with nested generics
type AdjList = Hashmap(str, array(str));

fn print_neighbors(graph: Hashmap(str, array(str)), node: str) {
    let neighbors = graph[node];
    for n in neighbors {
        Println(n);
    }
}

fn main() {
    // Nested generic in var declaration
    var graph: Hashmap(str, array(str)) = Hashmap(str, array(str));
    graph["a"] = ["b", "c"];
    graph["b"] = ["a"];

    Println(Len(graph));
    print_neighbors(graph, "a");

    // Using the type alias
    var g2: AdjList = Hashmap(str, array(str));
    g2["x"] = ["y", "z"];
    Println(Len(g2["x"]));

    // Hashmap with hashmap value
    var nested: Hashmap(str, Hashmap(str, int)) = Hashmap(str, Hashmap(str, int));
    var inner = Hashmap(str, int);
    inner["score"] = 100;
    nested["player1"] = inner;
    Println(nested["player1"]["score"]);
}
