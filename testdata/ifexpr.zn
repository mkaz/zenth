fn main() {
    let x = 10;
    let label = if x > 5 { "big" } else { "small" };
    Println(label);
    Println(if x > 100 { "huge" } else { "not huge" });
    let grade = if x > 9 { "A" } else if x > 7 { "B" } else { "C" };
    Println(grade);
    let n = if true { 42 } else { 0 };
    Println("{n}");
}
