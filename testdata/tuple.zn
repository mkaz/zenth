fn main() {
    let t = Tuple("a", 1);
    Println(t.0);
    Println(t.1);

    let u = Tuple(1, "x", true);
    Println(Str(u.0) + "-" + u.1 + "-" + Str(u.2));

    let pairs: array(Tuple(str, str)) = [];
    pairs.add(Tuple("left", "right"));
    Println(pairs[0].0 + ":" + pairs[0].1);

    let (cmd, raw) = "forward 10".split_once(" ");
    Println(cmd + ":" + raw);
}
