fn main() {
    // Named tuple creation and access by name
    let person = Tuple(name="Alice", age=30);
    Println(person.name);
    Println(person.age);

    // Access by numeric index still works
    Println(person.0);
    Println(person.1);

    // Named tuple with type annotation
    let t: Tuple(key: Str, value: Int) = Tuple(key="x", value=42);
    Println(t.key);
    Println(t.value);

    // Destructuring named tuples
    let (k, v) = t;
    Println(k);
    Println(v);

    // Array of named tuples
    let pairs: Array(Tuple(name: Str, score: Int)) = [];
    pairs.add(Tuple(name="Bob", score=95));
    pairs.add(Tuple(name="Carol", score=88));
    for p in pairs {
        Println(p.name + ":" + Str(p.score));
    }
}
